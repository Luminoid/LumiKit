# ---------------------------------------------------------------- 4. regex (after the type pass)
# Host labels: present(from:) for things that end in host.present, show(in:) for installed views.
regex	((?:LMKErrorHandler|LMKAlert|LMKActionSheet|LMKEnumPicker|LMKDatePicker)\.present\w*\(\s*)on:	${1}from:
regex	((?:LMKErrorHandler|LMKAlert|LMKActionSheet|LMKEnumPicker|LMKDatePicker)\.present\w*\(\s*)in:	${1}from:
regex	(LMKToast\.show\([^\n]*?)\bon:	${1}in:
regex	(LMKTip\.show\([^\n]*?)\bstyle:	${1}placement:
regex	(LMKTip\.show\([^\n]*?)\bon:	${1}in:
regex	\bonShowComplete:	completion:
regex	\.show\(on:	.show(in:
regex	\.showOnWindow\(	.show(
regex	\btapHandler:	onTap:
# Toast/banner initializers and the remaining generic show(type:)
regex	LMKToast\.show\(type:\s*(\.\w+),\s*message:	LMKToast.show($1,
regex	LMKToastView\(type:	LMKToastView(status:
regex	LMKBannerView\(type:	LMKBannerView(status:
# Button styles: color argument -> role; the same case names are presets on LMKButton.Style
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.primary\)	.${1}(.primary)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.secondary\)	.${1}(.secondary)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.tertiary\)	.${1}(.tertiary)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.error\)	.${1}(.destructive)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.warning\)	.${1}(.warning)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.success\)	.${1}(.success)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.info\)	.${1}(.info)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.textSecondary\)	.${1}(.neutral)
regex	\.(filled|outlined|ghost|iconOnly)\(LMKColor\.textPrimary\)	.${1}(.neutral)
# Factories: role-based buttons become LMKButton initializers; labels become lmk_make
regex	LMKButtonFactory\.(filled|outlined|ghost)\(\s*role:\s*(\.\w+),\s*title:\s*("[^"]*"|[\w.()]+),	LMKButton(title: $3, style: .${1}(${2}),
regex	LMKButtonFactory\.iconOnly\(\s*role:\s*(\.\w+),\s*iconName:\s*("[^"]*"|[\w.()]+),	LMKButton(systemImage: $2, style: .iconOnly(${1}),
regex	LMKLabelFactory\.(body|bodyMedium|bodyBold|subbodyMedium|caption|captionMedium|small|smallMedium)\(text:	UILabel.lmk_make(.${1}, text:
regex	LMKCardFactory\.elevatedCardView\(\)	LMKCardView(style: .elevated)
regex	LMKCardFactory\.flatCardView\(\)	LMKCardView(style: .flat)
regex	LMKCardFactory\.cardView\(\)	LMKCardView(style: .cell)
# Controls
regex	\.lmk_pointInside\(	.lmk_point(inside:
regex	(LMKProgressViewController\([^\n]*?)\bstyle:	${1}mode:

# ---------------------------------------------------------------- 5. members (type-blind)
member	tapHandler	onTap
member	actionHandler	onAction
member	dismissHandler	onDismiss
member	valueChangedHandler	onValueChange
member	stateChangedHandler	onValueChange
member	textChangedHandler	onTextChange
member	pageChangedHandler	onPageChange
member	multiSelectionChangedHandler	onSelectionChange
member	selectionChangedHandler	onSelectionChange
member	backAction	onBack
member	isChipSelected	isSelected
member	dismissSheet()	dismiss()
member	dismissPanel(	dismiss(
member	photoBrowserStrings	browserStrings
member	lmk_singleLineShrinkToFit(	shrinkingTitleToFit(
member	lmk_touchAreaEdgeInsets	lmk_hitTestInsets
member	enableNetworkLogging()	lmk_enableNetworkLogging()
member	nonEmpty	lmk_nonEmpty
member	[safe:	[lmk_safe:

# ---------------------------------------------------------------- 6. file-conditional
filematch	LMKEnumSelectable	var iconName: String \{	var iconName: String? {

# ---------------------------------------------------------------- 7. reports (hand edits)
regex	\.cornerStyle = \.(pill|rounded)\b	.style.corners = .${1}
regex	\.pinToTop\(of:	.install(in:
report	\bLMKTheme\.apply\(	Theme registration: pass a LMKTheme value. Convert `struct XTheme: LMKColorTheme { … }` into `extension LMKTheme { static let x = LMKTheme(colors: LMKColorTheme(primary: …)) }` and call `LMKTheme.apply(.x)`; only the colors that differ from the defaults need arguments.
report	:\s*LMKColorTheme\s*\{	LMKColorTheme is a struct now: replace the conformance with `extension LMKTheme { static let x = LMKTheme(colors: LMKColorTheme(…)) }` (see the theme recipe in docs/MIGRATION-1.0.md).
report	LMKTheme\.apply\(\s*(colors|typography|spacing|cornerRadius|shadow|alpha|layout|animation|badge):	reshape: per-category `apply(spacing: x)` became `LMKTheme.update { $0.spacing = x }` (reads: `LMKTheme.current.spacing`).
report	\bLMKTheme(?:\.shared)?\.configure\(	remove: `configure(colors:…)` is gone; build one `LMKTheme(colors:typography:spacing:…)` value and call `LMKTheme.apply(_:)`.
report	\bLMKTheme\.shared\b(?!\.configure\()	remove: `LMKThemeManager.shared` is gone; the theme is static API on `LMKTheme` (`LMKTheme.current.spacing`, `LMKTheme.current.badge` for the badge metrics, `LMKTheme.apply(_:)` and `LMKTheme.update { … }` to change it), so a stored manager reference goes away.
report	LMKColor\.(onAccent|scrim)\b	Review: `white` became `onAccent` (text on a filled accent) and `black` became `scrim` (dimming). Use literal `.white` / `.black` where the old token meant the actual color (forced-dark chrome, `layer.shadowColor`).
report	LMKColor\.photoBrowserBackground	remove: set `LMKPhotoBrowserViewController.Style.backgroundColor` (per instance or `theme.photoBrowser`) instead.
report	\.addAsChild\(	remove: `LMKBottomSheetViewController.addAsChild(sheet, in: host)` became the instance method `sheet.present(from: host)`.
report	LMKCardPanelViewController\.show\(	remove: `LMKCardPanelViewController.show(panel, in:)` became `panel.present(from: hostViewController)`.
report	LMKSearchBarDelegate|lmkSearchBar\w*\(	remove: the search-bar delegate is gone; set `onTextChange`, `onSearch`, `onBeginEditing`, `onEndEditing`, `onCancel` closures on the bar instead.
report	LMKPhotoCropDelegate|photoCropViewController\w*\(	remove: the crop delegate is gone; set `onCrop` / `onCancel` on `LMKPhotoCropViewController`.
report	LMKSharePreviewDelegate|sharePreview\w*\(	remove: the share-preview delegate is gone; set `onShare` / `onSave` / `onFailure` on `LMKSharePreviewViewController`.
report	\.configure\(count:|(?m:\.configure\(text:\s*[^,)]*\)[ \t]*$)|badge\.configure\(\)	reshape (LMKBadgeView only): `configure(count: n)` became `configure(.count(n))`, `configure(text: s)` became `configure(.text(s))`, the dot badge is `configure(.dot)`.
report	\.(badgeColor|borderColor)\s*=|LMKDividerView\.defaultThickness|\.thickness\s*=	reshape: badge and divider colors/thickness are `style` fields (`badge.style.surface.background = .solid(c)`, `divider.style.thickness = t`).
report	LMKLoadingStateView\([^)]*overlayStyle:	reshape: `LMKLoadingStateView(overlayStyle: true)` became `LMKLoadingStateView(style: .overlay)`.
report	\.configure\(message:|LMKEmptyStateView\.(inlineCellHeight|cardCellHeight|fullScreenCellHeight|inlineHorizontalInsets)	reshape: `configure(message:icon:style:action:)` became `configure(LMKEmptyStateView.Content(title:message:icon: .system("name"), primaryAction:))` with the layout in `style.layout`; size the row yourself.
report	LMKGlassView\.makeContainer\(	Review: `makeContainer` now returns `LMKGlassContainerView` (typed; `spacing` is settable).
report	LMKFloatingButton\.current|LMKFloatingButton\.dismissCurrent\(|\.showBadge\(|\.hideBadge\(	reshape: the floating button has no global; keep the instance from `LMKFloatingButton.show(icon:in:onTap:)` (or `button.show(in:)`), call `dismiss()` on it, and set `badge = .count(n)` / `.dot` / `nil`.
report	LMKTip\.show\([^)]*\n[^)]*\b(style|on):	Review: multi-line tip call still passes `style:` / `on:`; rename to `placement:` / `in:`.
report	\.expandsActiveDot\s*=|\.maxVisibleDots\s*=	Review (LMKPageIndicator): `expandsActiveDot` still works as a property (it writes `style.expandsActiveDot`); dot sizes and colors are `style` fields.
report	\.showsCancelButton\s*=	reshape (LMKSearchBar): `showsCancelButton` is read-only; set `cancelButtonMode = .always | .never | .automatic`.
report	LMKTextView\(\)[^\n]*\n?[^\n]*\.minimumHeight\s*=\s*\d	Review (LMKTextView): `minimumHeight` is now optional (`CGFloat?`); `maximumHeight` caps growth.
report	\.chipColor\b	reshape: `chipColor` became `style.tintColor` (`chip.style = .filled.tint(color)` or `chip.style.tintColor = color`).
report	\.(cardBackgroundColor|cardCornerRadius)\b|LMKCardView\(\)\.contentInsets|card\.contentInsets\s*=	reshape: card appearance is `style.surface` (`card.style.surface.background = .solid(c)`, `.corners = .fixed(r)`, `.contentInsets = …`).
report	LMKStatus\.\w+\.iconName|status\.iconName|type\.iconName	reshape: `LMKStatus.iconName` became `systemImageName: String?` (`.neutral` has none).
report	LMKToastView\.defaultDuration|\.showOnWindow\(	reshape: `LMKToast.defaultDuration`; window presentation is `LMKToast.show(.status, message)` with no `in:` (or `presentation: .inWindowScene(nil)`).
report	\.didTapHandler\b	remove: `didTapHandler` is gone; use `onTap` and capture the button.
report	\.applyStyle\(|\.applyIconStyle\(	remove: `applyStyle(.filled(c), title: t)` became `button.style = .filled(.role); button.title = t`; `applyIconStyle` became `button.style = .iconOnly(); button.setSymbol("name")`.
report	\.configuration\?\.(title|image|imagePlacement|imagePadding|contentInsets)\s*=	Review: LMKButton now exposes `title`, `image`, `setSymbol(_:)`, and `style.imagePlacement` / `style.imagePadding` / `style.surface.contentInsets`; keep `configuration?` only on plain UIButtons.
report	LMKButtonFactory|LMKLabelFactory|LMKCardFactory	remove: the factories are gone; `LMKButton(title:style:)`, `UILabel.lmk_make(_:text:color:)`, `LMKCardView(style:)` (add subviews to `contentView`).
report	LMKLabelFactory\.heading\(	remove: `heading(text:level:)` became `UILabel.lmk_make(.h1|.h2|.h3|.h4, text:)`.
report	\bLMKToggleButton\b|ToggleState|lmkToggleButtonStrings	remove: LMKToggleButton is gone; use `LMKButton` with `isToggle = true`, `selectedTitle` / `selectedImage`, and `onValueChange`.
report	LMKKeyboardInsetHelper|LMKKeyboardObserver	remove: use `scrollView.lmk_enableKeyboardAdjustment()` / `lmk_disableKeyboardAdjustment()`.
report	\.lmk_fadeIn\(|\.lmk_fadeOut\(	remove: `view.lmk_fadeIn(…)` became `LMKAnimation.fadeIn(view, …)` (same for fadeOut).
report	lmk_safeAreaSnp|lmk_setEdgesEqualToSuperview|lmk_centerInSuperview|lmk_setAutoLayoutSize	remove: write the SnapKit constraints directly (`safeAreaLayoutGuide.snp`, `edges.equalToSuperview()`, `center.equalToSuperview()`).
report	lmk_configureCellHighlight\(	remove: call `cell.lmk_configureCustomHighlight()` on the cell.
report	lmk_animatePress\(	remove: use `LMKButton` (press animation built in) or `LMKAnimation.animateButtonPress(_:)`.
report	lmk_configureIconListRow\(	remove: became `cell.lmk_applyListRow(LMKListRowConfiguration(title:) …)`; see the list-row recipe.
report	lmk_emptyStateCell\(	remove: host the `LMKEmptyStateView` yourself (`wrappedForTableBackground`) and size the row.
report	LMKPhotoMetadata\.(extractDate|extractLocation)\(	remove: `await LMKPhotoMetadata.read(from: pickerResult).date` / `.coordinate`; pass raw `Data`, never a decoded `UIImage`.
report	LMKDateFormat\.(dateFormatter|configure)\(	remove: `LMKDateFormat.string(date, date: .medium, time: .none)`; a user-chosen pattern goes through `LMKDateFormat.preferredDatePattern`.
report	\.presentMultiSelect\(	remove: `LMKEnumPicker.present(from:title:options:selection:onSelect:)` with a `Set<T>` selection (multi-select is chosen by the selection type).
report	LMKLayout\.(searchBarHeight|searchBarIconSize|clearButtonSize)\b	Review: the search-bar metrics moved to `LMKSearchBar.Style` (`height`, `iconSize`, `clearButtonSize`).
report	\bLMKBadge\.|\bLMKBadgeTheme\b	remove: badge metrics live on `LMKBadgeView.Style` (app-wide via `theme.badge`).
report	LMKBottomSheetLayout|LMKCardPageLayout|LMKCardPanelLayout|LMKTipLayout|LMKFloatingButtonLayout|LMKPhotoBrowserConfig	remove: the constant bags are gone; themeable values are `Style` fields on the owning component.
report	override (open |public )?var (headerHeight|showsLeadingButton|showsTrailingButton|showsHeaderSeparator|trailingButtonSymbol|leadingButtonSymbol|cardMaxWidth|cardHorizontalInset|cardMaxHeightRatio|dismissesOnBackgroundTap|stackSpacing|contentInsets|keyboardDismissMode|alwaysBounceVertical|scrollViewUseSafeArea|edgePanBandWidth|commitVelocityThreshold)\b	Review: appearance overrides on the base controllers became `Style` fields (`style.headerHeight = …` in `init`; `cardMaxHeightRatio` is `LMKCardPanelViewController.Style.heightRatio`, an exact height fraction); `dismissesOnBackgroundTap` is an instance property.
report	override (open |public )?func (dismissSheet|dismissPanel|onDismissTapped)\b	Review: `dismiss()` is the single dismissal; `onDismissTapped()` became `onDismiss: ((DismissReason) -> Void)?`.
report	\.(selectedIndex|setSelectedIndex\(|selectedIndices|setSelectedIndices\(|allowsMultipleSelection)\b	Review (LMKFilterChipBar only): selection is one `selection: Set<Int>` with `setSelection(_:animated:)`, `selectionMode`, and `onSelectionChange: (Set<Int>) -> Void`.
report	\.(fitsSegmentsToContent|isScrollable|scrollableItemPadding|itemSpacing|makeScrollableContainer|itemPadding)\b	Review (LMKSegmentedControl only): the layout knobs became `style.layout = .equalWidth | .fitContent | .scrollable(padding:spacing:)` and `itemPadding` moved to `style.itemPadding`; the control owns its scroll view.
report	\bLMKButton\.Style\b.*=\s*\.(filled|outlined|ghost|iconOnly)\((?!\.)	Review: `LMKButton.Style` presets take a role (`.filled(.primary)`), not a color; use `.tint(_:)` for a custom color.
report	\blmk_hitTestInsets\s*=	Review: has no effect unless the owner overrides `point(inside:with:)` and calls `lmk_point(inside:with:)`; LumiKit controls enforce 44pt targets themselves, so delete dead assignments.
report	subscript\(safe|var nonEmpty\b	Review: a local declaration collides with LumiKit's `[lmk_safe:]` / `lmk_nonEmpty`; delete the copy or rename it.
report	\bLMKLocaleHelper\b	Review: the `LMK` prefix is reserved for LumiKit; rename the app's helper.
report	(LMKAlert|LMKErrorHandler|LMKActionSheet|LMKEnumPicker|LMKDatePicker)\.\w+\([^)]*\n\s*on:	Review: multi-line call still passes `on:`; rename the label to `from:`.
report	LMKToast\.show\([^)]*\n\s*on:	Review: multi-line toast call still passes `on:`; rename the label to `in:`.
report	\.(barBackgroundColor|largeTitleFont|largeTitleColor|inlineTitleFont|inlineTitleColor|buttonTintColor)\b	Review (LMKNavigationBar only): appearance moved to `style` (`surface.background`, `tintColor`, `titleTextStyle` / `titleColor`, `largeTitleTextStyle` / `largeTitleColor`).
report	\.set(Left|Right)ItemEnabled\(at:	remove: give the item an `identifier` and call `updateItem("id") { $0.isEnabled = ... }`.
report	\.showsSeparator\s*=	Review (LMKNavigationBar only): `showsSeparator` is a Style field (`style.showsSeparator`).
report	override (open |public )?func refreshSheetColors\b	Review: `refreshSheetColors()` is gone; override `applyTheme(_:)` (call `super`) and use `style` fields.
report	\bsuper\.init\(cancelTitle:	Review: `LMKBottomSheetViewController.init(cancelTitle:)` became `init(style:)`; set `strings.cancel` per instance for a custom title.
report	\bcontainerBottomConstraint\b	remove: the constraint is internal; use `additionalBottomInset` for a manual lift (the keyboard lift is built in).
report	\bLMKActionSheet\(	remove: build an `LMKActionSheet.Configuration` and call `LMKActionSheet.present(_:from:)` (the class is `LMKActionSheetViewController`).
report	\bcontentHeight:	Review (LMKActionSheet): custom content is self-sizing; drop `contentHeight:` and give the view an intrinsic size or constraints.
report	LMKActionSheet\.present\([^)]*\bonDismiss:	Review: the action sheet reports cancellation through `Configuration.onCancel` (or the sheet's `onDismiss(reason)`).
report	\bcurrentSelection:	Review (LMKEnumPicker): `present(from:title:options:selection:onSelect:)`; a `T?` selection is single-select, a `Set<T>` is multi-select; `showIcons:` became `showsIcons:` (default on).
report	var iconName: String \{	Review (LMKEnumSelectable): `iconName` is `String?` with a default of `nil`; change the type or delete the property.
report	LMKDatePicker\.present(DatePickerAlert|DatePicker|FutureDatePicker|PastDatePicker|DateRangePicker|CalendarRangePicker|DatePickerWithTextField)\(	Review: `LMKDatePicker.present(_ configuration:from:onConfirm:)` with `Configuration(...)`, `.past(...)`, `.future(...)`; ranges via `presentRange` / `presentCalendarRange`; notes via `presentWithTextField`.
report	override (open |public )?(var|func) (leadingButtonSymbol|trailingButtonSymbol|showsLeadingButton|showsTrailingButton|showsHeaderSeparator|refreshCardPageColors|trailingButtonTapped)\b	Review (LMKCardPageViewController): set `leadingItem` / `trailingItem` (`LMKNavigationBarItem`) and `style.showsHeaderSeparator` in `init`; `applyTheme(_:)` replaces the color refresh.
report	override (open |public )?var dismissesOnBackgroundTap\b	Review (LMKCardPanelViewController): `dismissesOnBackgroundTap` is an instance property now.
report	override (open |public )?func installSegmentedControl\b	Review (LMKSegmentedPageViewController): set `segmentedControlPlacement = .container(slot)` (build the slot before `super.viewDidLoad()`) or `.manual`.
report	LMKOverscrollFooterView\(footerView:	remove: `LMKOverscrollFooterView(contentView:height:)` + `attach(to: scrollView)`; it follows the scroll view itself (drop `updatePosition()` calls and the `overscrollProgress` alpha plumbing).
report	presentActionSheet\([^)]*actions: \[\(	Review (LMKAlert): actions are `[LMKAlert.Action]` (title, image, style, isEnabled, handler); pass `anchor:` for the iPad popover.
report	presentTextInput\([^)]*\b(autocapitalizationType|autocorrectionType|keyboardType|configureField|saveTitle|cancelTitle):	Review (LMKAlert): the long form became `presentTextInput(LMKAlert.TextInput(...), from:onSave:)` (adds `isSecure` and `validate`).
report	LMKFormScaffold\.install\([^)]*contentInsets: UIEdgeInsets	Review: `contentInsets` is `NSDirectionalEdgeInsets` now; `widthMode:` adds `.readable` / `.capped`.
report	\.setSubtitle\(	Review (LMKProgressViewController): `subtitle` is a property; `setState(_:message:)` covers terminal states.
