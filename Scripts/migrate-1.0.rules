# LumiKit 0.x -> 1.0 migration rules. Applied by Scripts/migrate-1.0.sh; rendered into
# docs/MIGRATION-1.0.md by `--print-table`. Tab-separated: kind<TAB>old<TAB>new[<TAB>note].
#
# Pass order (the script enforces it):
#   1. product   literal module/product names (imports, pbxproj, Package.swift, project.yml)
#   2. path      dotted paths written with the OLD type name on the left of the dot; the type pass
#                renames the type afterwards, so a rule may map into another old type's namespace
#                (e.g. LMKCountdownConfirmation.present( -> LMKAlertPresenter.presentCountdownConfirmation()
#                and must never produce a NEW type name that is also an OLD name (LMKTheme)
#   3. type      identifiers, one simultaneous word-boundary alternation, longest-first
#   4. regex     perl patterns applied after the type pass (labels, factory forms, color roles)
#   5. member    type-blind `.old` -> `.new` member renames (skippable with --no-members)
#   6. filematch precondition<TAB>pattern<TAB>replacement, applied only in files whose text matches the precondition
#   7. report    pattern<TAB>recipe: hand edits, printed by file:line; `remove:` recipes fail the run while present

# ---------------------------------------------------------------- 1. products
product	LumiKitNetwork	LumiKitDebug

# ---------------------------------------------------------------- 2. dotted paths (old type on the left)
# Theme store: LMKThemeManager becomes the static API on LMKTheme (the type pass renames the identifier).
path	LMKThemeManager.shared.apply(	LMKThemeManager.apply(
path	LMKThemeManager.shared.reset()	LMKThemeManager.reset()
path	LMKThemeManager.shared.current	LMKThemeManager.current.colors
path	LMKThemeManager.shared.typography	LMKThemeManager.current.typography
path	LMKThemeManager.shared.spacing	LMKThemeManager.current.spacing
path	LMKThemeManager.shared.cornerRadius	LMKThemeManager.current.cornerRadius
path	LMKThemeManager.shared.shadow	LMKThemeManager.current.shadow
path	LMKThemeManager.shared.alpha	LMKThemeManager.current.alpha
path	LMKThemeManager.shared.layout	LMKThemeManager.current.layout
path	LMKThemeManager.shared.animation	LMKThemeManager.current.animation
# Debug nested records (qualified form first; the type pass catches bare uses)
path	LMKNetworkRequestRecord.LMKRequestData	LMKNetworkRequestRecord.Request
path	LMKNetworkRequestRecord.LMKResponseData	LMKNetworkRequestRecord.Response
# Alerts
path	LMKAlertPresenter.presentAlert(	LMKAlertPresenter.present(
path	LMKCountdownConfirmation.present(	LMKAlertPresenter.presentCountdownConfirmation(
# Utilities folded into subject namespaces
path	LMKSceneUtil.getKeyWindow()	LMKSceneUtil.keyWindow
path	LMKImageUtil.getSFSymbolImage(	LMKImageUtil.symbol(
path	LMKDominantColorExtractor.dominantColors(	LMKImageUtil.dominantColors(
path	LMKDominantColorExtractor.dominantColor(	LMKImageUtil.dominantColor(
path	LMKDominantColorExtractor.Strategy	LMKImageUtil.DominantColorStrategy
path	LMKQRCodeGenerator.generateQRCode(	LMKImageUtil.qrCode(
path	LMKQRCodeGenerator.CorrectionLevel	LMKImageUtil.QRCorrectionLevel
path	LMKDateFormatterHelper.formatNumber(	LMKFormatHelper.number(
path	LMKDateFormatterHelper.numberFormatter()	LMKFormatHelper.numberFormatter()
path	LMKShareService.shareImage(	LMKShareService.image(
path	LMKShareService.shareFile(	LMKShareService.file(
# Toast: ten entry points collapse into LMKToast.show(_ status:, _ message:, …). Longest first.
path	LMKToast.showSuccessOnWindow(message:	LMKToast.show(.success,
path	LMKToast.showWarningOnWindow(message:	LMKToast.show(.warning,
path	LMKToast.showErrorOnWindow(message:	LMKToast.show(.error,
path	LMKToast.showInfoOnWindow(message:	LMKToast.show(.info,
path	LMKToast.showSuccess(message:	LMKToast.show(.success,
path	LMKToast.showWarning(message:	LMKToast.show(.warning,
path	LMKToast.showError(message:	LMKToast.show(.error,
path	LMKToast.showInfo(message:	LMKToast.show(.info,
# Alpha ramp (values unchanged)
path	LMKAlpha.overlayLight	LMKAlpha.xxs
path	LMKAlpha.overlayMedium	LMKAlpha.xs
path	LMKAlpha.overlayDark	LMKAlpha.small
path	LMKAlpha.semiTransparent	LMKAlpha.medium
path	LMKAlpha.overlayStrong	LMKAlpha.xl
path	LMKAlpha.overlayOpaque	LMKAlpha.xxl
path	LMKAlpha.dimmingOverlay	LMKAlpha.dimming
path	LMKAlpha.overlay	LMKAlpha.large
# Shadow presets -> levels (resolved styles keep working everywhere a LMKShadowStyle is expected)
path	LMKShadow.cellCard()	LMKShadow.style(for: .level2)
path	LMKShadow.button()	LMKShadow.style(for: .level2)
path	LMKShadow.small()	LMKShadow.style(for: .level1)
path	LMKShadow.medium()	LMKShadow.style(for: .level4)
path	LMKShadow.large()	LMKShadow.style(for: .level5)
path	LMKShadow.card()	LMKShadow.style(for: .level3)
path	LMKShadow.opacity	LMKShadow.iconOverlayOpacity
# Animation durations: thirteen names -> seven steps
path	LMKAnimationHelper.Duration.buttonPress	LMKAnimationHelper.Duration.instant
path	LMKAnimationHelper.Duration.uiShort	LMKAnimationHelper.Duration.fast
path	LMKAnimationHelper.Duration.photoLoad	LMKAnimationHelper.Duration.fast
path	LMKAnimationHelper.Duration.actionSheet	LMKAnimationHelper.Duration.normal
path	LMKAnimationHelper.Duration.alert	LMKAnimationHelper.Duration.normal
path	LMKAnimationHelper.Duration.modalPresentation	LMKAnimationHelper.Duration.moderate
path	LMKAnimationHelper.Duration.listInsertDelete	LMKAnimationHelper.Duration.moderate
path	LMKAnimationHelper.Duration.listUpdate	LMKAnimationHelper.Duration.moderate
path	LMKAnimationHelper.Duration.cardExpand	LMKAnimationHelper.Duration.moderate
path	LMKAnimationHelper.Duration.screenTransition	LMKAnimationHelper.Duration.slow
path	LMKAnimationHelper.Duration.errorShake	LMKAnimationHelper.Duration.slow
path	LMKAnimationHelper.Duration.successFeedback	LMKAnimationHelper.Duration.emphasis
path	LMKAnimationHelper.Spring.damping	LMKAnimationHelper.spring.damping
path	LMKAnimationHelper.Curve.easeInOut	LMKAnimationHelper.Curve.easeInOut.options
path	LMKAnimationHelper.Curve.easeOut	LMKAnimationHelper.Curve.easeOut.options
path	LMKAnimationHelper.Curve.easeIn	LMKAnimationHelper.Curve.easeIn.options
# Color roles
path	LMKColor.primaryDark	LMKColor.primaryVariant
path	LMKColor.imageBorder	LMKColor.outline
path	LMKColor.graySoft	LMKColor.fillStrong
path	LMKColor.grayMuted	LMKColor.fill
path	LMKColor.white	LMKColor.onAccent
path	LMKColor.black	LMKColor.scrim
# Nested enums that were top-level
path	LMKActionSheet.ActionStyle	LMKActionSheet.Action.Style
path	LMKGlassView.Style	LMKGlassView.Variant
path	LMKProgressViewController.Style	LMKProgressViewController.Mode
path	LMKSegmentedControl.CornerStyle	LMKSegmentedControl.Corners
# Module-level string globals -> nested Strings
path	lmkBadgeStrings	LMKBadgeView.strings
path	lmkCheckboxCellStrings	LMKCheckboxCell.strings
path	lmkPhotoCropStrings	LMKPhotoCropViewController.strings

